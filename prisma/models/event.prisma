model Event {
  id           String            @id @default(uuid())
  title        String
  eventType    EventType         @default(EVENT)
  startDate    DateTime
  startTime    String
  endTime      String
  isAllDay     Boolean           @default(false)
  locationType EventLocationType @default(OFFLINE)
  location     String?
  meetingLink  String?
  description  String?
  coverImage   String?
  createdById  String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?
  attachments  EventAttachment[]
  guests       EventGuest[]
  createdBy    Doctor            @relation("DoctorEvents", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([startDate])
  @@index([eventType])
  @@map("events")
}

model EventGuest {
  id               String   @id @default(uuid())
  eventId          String
  email            String
  notificationSent Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  event            Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([email])
  @@map("event_guests")
}

model EventAttachment {
  id        String   @id @default(uuid())
  eventId   String
  url       String
  title     String?
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_attachments")
}

model Appointment {
  id                 Int                 @id @default(autoincrement())
  patientId          String?
  insuranceId        String?
  doctorId           String?
  firstName          String?
  lastName           String?
  email              String?
  phone              String?
  dob                DateTime?
  gender             Gender?
  bloodGroup         BloodGroup?
  appointmentDate    DateTime?
  startTime          String?
  endTime            String?
  scheduleSlotId     String?
  appointmentTypeId  String?
  appointmentDetails String?
  address            String?
  status             AppointmentStatus?  @default(SCHEDULED)
  createdAt          DateTime?           @default(now())
  updatedAt          DateTime?           @updatedAt
  deletedAt          DateTime?
  appointmentType    AppointmentType?    @relation(fields: [appointmentTypeId], references: [id])
  doctor             Doctor?             @relation("DoctorAppointments", fields: [doctorId], references: [id])
  patient            Patient?            @relation("PatientAppointments", fields: [patientId], references: [id])
  scheduleSlot       DoctorScheduleSlot? @relation("AppointmentScheduleSlot", fields: [scheduleSlotId], references: [id])
  callTranscriptions CallTranscription[] @relation("AppointmentCallTranscription")
  labs               Lab[]
  prescriptions      Prescription[]

  @@map("appointments")
}

model DoctorWeeklySchedule {
  id                  String               @id @default(uuid())
  doctorId            String
  day                 WeekDay
  isClosed            Boolean              @default(false)
  firstHalfStartTime  String?
  firstHalfEndTime    String?
  secondHalfStartTime String?
  secondHalfEndTime   String?
  slots               DoctorScheduleSlot[]
  doctor              Doctor               @relation(fields: [doctorId], references: [id])

  @@unique([doctorId, day])
  @@map("doctor_weekly_schedules")
}

model DoctorScheduleSlot {
  id           String               @id @default(uuid())
  scheduleId   String
  startTime    String
  endTime      String
  appointments Appointment[]        @relation("AppointmentScheduleSlot")
  schedule     DoctorWeeklySchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@map("doctor_schedule_slots")
}

model Call {
  id                 String      @id @default(uuid())
  patientId          String?
  doctorId           String?
  startAt            DateTime?
  endAt              DateTime?
  durationSeconds    Int?
  status             CallStatus?
  recordingUrlCipher String?
  transcript         String?
  aiSummary          String?
  sentiment          Sentiment?
  escalated          Boolean?
  minutesUsed        Int?
  createdAt          DateTime?   @default(now())
  updatedAt          DateTime?   @updatedAt
  aiModelId          String?
  aiDecision         String?
  doctor             Doctor?     @relation("DoctorCalls", fields: [doctorId], references: [id])
  patient            Patient?    @relation(fields: [patientId], references: [id])

  @@map("calls")
}

model Diagnosis {
  id            String    @id @default(uuid())
  patientId     String?
  doctorId      String?
  diagnosisCode String?
  diagnosisName String?
  description   String?
  status        String?
  diagnosedDate DateTime?
  resolvedDate  DateTime?
  createdAt     DateTime? @default(now())
  updatedAt     DateTime? @updatedAt
  doctor        Doctor?   @relation("DoctorDiagnoses", fields: [doctorId], references: [id])
  patient       Patient?  @relation(fields: [patientId], references: [id])

  @@map("diagnoses")
}

model Lab {
  id              String       @id @default(uuid())
  patientId       String?
  doctorId        String?
  appointmentId   Int?
  testDate        DateTime?
  additionalNotes String?
  createdAt       DateTime?    @default(now())
  updatedAt       DateTime?    @updatedAt
  deletedAt       DateTime?
  results         LabResult[]
  appointment     Appointment? @relation(fields: [appointmentId], references: [id])
  doctor          Doctor?      @relation("DoctorLabs", fields: [doctorId], references: [id])
  patient         Patient?     @relation(fields: [patientId], references: [id])

  @@map("labs")
}

model LabResult {
  id        String  @id @default(uuid())
  labId     String?
  testName  String?
  result    String?
  unit      String?
  normalMin Float?
  normalMax Float?
  flag      Flag?
  lab       Lab?    @relation(fields: [labId], references: [id])

  @@map("lab_results")
}

model Prescription {
  id              String              @id @default(uuid())
  patientId       String?
  doctorId        String?
  appointmentId   Int?
  prescriptionNo  String?             @unique
  status          PrescriptionStatus? @default(ACTIVE)
  instructions    String?
  additionalNotes String?
  createdAt       DateTime?           @default(now())
  updatedAt       DateTime?           @updatedAt
  deletedAt       DateTime?
  items           PrescriptionItem[]
  appointment     Appointment?        @relation(fields: [appointmentId], references: [id])
  doctor          Doctor?             @relation("DoctorPrescriptions", fields: [doctorId], references: [id])
  patient         Patient?            @relation(fields: [patientId], references: [id])

  @@map("prescriptions")
}

model PrescriptionItem {
  id                   String       @id @default(uuid())
  prescriptionId       String
  medicineName         String?
  medicineInstructions String?
  morningDosage        Float?
  afternoonDosage      Float?
  nightDosage          Float?
  createdAt            DateTime?    @default(now())
  updatedAt            DateTime?    @updatedAt
  prescription         Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@map("prescription_items")
}

model CallTranscription {
  id               String       @id @default(uuid())
  doctorId         String
  patientId        String?
  callSid          String?      @unique
  agentId          String?
  phoneNumber      String?
  duration         Int?
  audioUrl         String?
  transcription    String?
  intent           CallIntent?
  sentiment        Sentiment?
  summary          String?
  callStatus       CallStatus?
  reasonForCalling String?
  insuranceId      String?
  callerName       String?
  appointmentId    Int?
  fallbackNumber   String?
  wasTransferred   Boolean?     @default(false)
  isReviewed       Boolean      @default(false)
  callStartedAt    DateTime?
  callEndedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  minutesDeducted  Int?         @default(0)
  appointment      Appointment? @relation("AppointmentCallTranscription", fields: [appointmentId], references: [id])
  doctor           Doctor       @relation("DoctorCallTranscriptions", fields: [doctorId], references: [id])
  patient          Patient?     @relation("PatientCallTranscriptions", fields: [patientId], references: [id])

  @@index([doctorId, createdAt])
  @@index([patientId, createdAt])
  @@index([agentId])
  @@map("call_transcriptions")
}

model DoctorKnowledgeBase {
  id        String                 @id @default(uuid())
  doctorId  String
  category  KnowledgeBaseCategory? @default(GENERAL)
  question  String
  answer    String
  keywords  String[]
  isActive  Boolean                @default(true)
  priority  Int                    @default(0)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  doctor    Doctor                 @relation("DoctorKnowledgeBase", fields: [doctorId], references: [id])

  @@index([doctorId, category])
  @@index([doctorId, isActive])
  @@map("doctor_knowledge_base")
}

model AppointmentType {
  id           String        @id @default(uuid())
  doctorId     String
  name         String
  duration     Int
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  doctor       Doctor        @relation(fields: [doctorId], references: [id])
  appointments Appointment[]

  @@map("appointment_types")
}

model DoctorAbsence {
  id        String   @id @default(uuid())
  doctorId  String
  fromDate  DateTime
  toDate    DateTime
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  doctor    Doctor   @relation("DoctorAbsences", fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, fromDate, toDate])
  @@map("doctor_absences")
}

model Admin {
  id                   String          @id @default(uuid())
  email                String          @unique
  passwordHash         String?
  firstName            String?
  lastName             String?
  photo                String?
  phone                String?
  dob                  DateTime?
  address              String?
  gender               Gender?
  emailVerifiedAt      DateTime?
  twoFactorSecret      String?
  twoFactorEnabled     Boolean?        @default(true)
  lastLoginAt          DateTime?
  createdAt            DateTime?       @default(now())
  updatedAt            DateTime?       @updatedAt
  deletedAt            DateTime?
  failedLoginAttempts  Int             @default(0)
  lastPasswordChangeAt DateTime?
  auditLogs            AuditLog[]
  passwordResets       PasswordReset[]
  sessions             Session[]
  twoFactorOtps        TwoFactorOtp[]
  user                 User?

  @@map("admins")
}

model Doctor {
  id                         String                      @id @default(uuid())
  email                      String?                     @unique
  phone                      String?                     @unique
  passwordHash               String?
  firstName                  String?
  lastName                   String?
  licenceNo                  String?
  specialities               String[]
  experience                 String?
  emailVerifiedAt            DateTime?
  dob                        DateTime?
  photo                      String?
  gender                     Gender?
  address                    String?
  twoFactorSecret            String?
  twoFactorEnabled           Boolean?                    @default(true)
  lastLoginAt                DateTime?
  createdAt                  DateTime?                   @default(now())
  updatedAt                  DateTime?                   @updatedAt
  deletedAt                  DateTime?
  failedLoginAttempts        Int                         @default(0)
  lastPasswordChangeAt       DateTime?
  elevenlabsAgentId          String?
  conversations              AdminConversation?
  appointmentTypes           AppointmentType[]
  appointments               Appointment[]               @relation("DoctorAppointments")
  auditLogs                  AuditLog[]
  callTranscriptions         CallTranscription[]         @relation("DoctorCallTranscriptions")
  calls                      Call[]                      @relation("DoctorCalls")
  diagnoses                  Diagnosis[]                 @relation("DoctorDiagnoses")
  absences                   DoctorAbsence[]             @relation("DoctorAbsences")
  knowledgeBase              DoctorKnowledgeBase[]       @relation("DoctorKnowledgeBase")
  doctorNotificationSettings DoctorNotificationSettings?
  doctorRegionalSettings     DoctorRegionalSettings?
  doctorSecuritySettings     DoctorSecuritySettings?
  doctorNotifications         DoctorNotification[]
  weeklySchedules            DoctorWeeklySchedule[]
  events                     Event[]                     @relation("DoctorEvents")
  labs                       Lab[]                       @relation("DoctorLabs")
  passwordResets             PasswordReset[]
  prescriptions              Prescription[]              @relation("DoctorPrescriptions")
  sessions                   Session[]
  staff                      Staff[]
  subscriptionHistory        SubscriptionHistory[]
  subscription               Subscription?
  tasks                      Task[]
  twoFactorOtps              TwoFactorOtp[]
  user                       User?

  @@map("doctors")
}

model Session {
  id                    String    @id @default(uuid())
  adminId               String?
  doctorId              String?
  accessToken           String    @unique
  refreshToken          String    @unique
  isActive              Boolean   @default(true)
  isRevoked             Boolean   @default(false)
  revokedAt             DateTime?
  lastActivity          DateTime  @default(now())
  refreshTokenExpiresAt DateTime
  createdAt             DateTime? @default(now())
  updatedAt             DateTime  @updatedAt
  admin                 Admin?    @relation(fields: [adminId], references: [id])
  doctor                Doctor?   @relation(fields: [doctorId], references: [id])

  @@map("sessions")
}

model PasswordReset {
  id         String    @id @default(uuid())
  email      String
  otp        String
  token      String?   @unique
  expiresAt  DateTime
  verifiedAt DateTime?
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  adminId    String?
  doctorId   String?
  admin      Admin?    @relation(fields: [adminId], references: [id])
  doctor     Doctor?   @relation(fields: [doctorId], references: [id])

  @@map("password_resets")
}

model User {
  id                 String              @id @default(uuid())
  adminId            String?             @unique
  doctorId           String?             @unique
  role               UserRole
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  adminConversations AdminConversation[] @relation("AdminConversations")
  conversations      AdminConversation[] @relation("UserConversations")
  sentMessages       SupportMessage[]
  admin              Admin?              @relation(fields: [adminId], references: [id])
  doctor             Doctor?             @relation(fields: [doctorId], references: [id])

  @@map("users")
}

model TwoFactorOtp {
  id         String    @id @default(uuid())
  email      String
  otp        String
  expiresAt  DateTime
  verifiedAt DateTime?
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  adminId    String?
  doctorId   String?
  admin      Admin?    @relation(fields: [adminId], references: [id])
  doctor     Doctor?   @relation(fields: [doctorId], references: [id])

  @@map("two_factor_otps")
}
